POSTGRES_DB=dataforge
POSTGRES_USER=dataforge
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
DATAFORGE_JWT_SECRET=<generate-a-secret-at-least-32-characters-long>
DATAFORGE_JWT_ALGORITHM=HS256
DATAFORGE_JWT_ISSUER=dataforge-api
DATAFORGE_JWT_AUDIENCE=dataforge-api
DATAFORGE_ACCESS_TOKEN_LIFETIME_SECONDS=900
DATAFORGE_DATABASE_URL=postgresql+asyncpg://dataforge:replace-with-a-local-password@localhost:5432/dataforge
